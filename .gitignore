# ──────────────────────────────────────────────────────────────
# .gitignore — CPEC Multi-Hazard EWS
# ──────────────────────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# API credentials — NEVER commit these
.cdsapirc
.netrc
*.env
.env
.env.local
secrets.json

# Jupyter / Colab
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Large data files (generated by Python, commit only dashboard_data.json)
*.nc
*.HDF5
*.h5
*.hdf
*.tif
*.tiff

# Keep public/ outputs but ignore huge files
public/pak_adm2.geojson

# Node (if using Vercel CLI locally)
node_modules/
.vercel/
